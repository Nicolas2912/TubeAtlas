{
  "name": "tubeatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:api": "node --watch --env-file-if-exists=.env server/src/main.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env server/src/db.ts --migrate",
    "check": "tsc -p server && tsc -p frontend && npm run build",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:providers": "node --env-file-if-exists=.env scripts/check-providers.ts",
    "kg": "node --env-file-if-exists=.env scripts/kg.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^13.0.3",
    "cytoscape": "^3.34.3",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "youtube-transcript": "1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
